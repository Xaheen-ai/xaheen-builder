{
    "name": "@xala/gazetteer-compiler",
    "version": "0.1.0",
    "description": "Compiler for Chef DSL to Gazetteer PageSpec",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "typescript": "^5.3.0"
    },
    "peerDependencies": {
        "@xala/chef-dsl": "^0.1.0"
    },
    "files": [
        "dist",
        "src"
    ],
    "license": "UNLICENSED"
}